# ========================================================
# ResuMine Environment Configuration (Example Template)
# ========================================================

# Server Port
PORT=5001
NODE_ENV=development

# Google Gemini API Key (Get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# MongoDB Connection String (Optional for local development)
MONGODB_URI=mongodb://localhost:27017/resumine

# JWT Secret for User Authentication
JWT_SECRET=super_secret_jwt_resumine_2025
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

